# ========================================
# Astra-AI Configuration Template
# ========================================
# Copy this file to .env and fill in your values

# ========================================
# OPEN SOURCE MODEL SETTINGS
# ========================================

# HuggingFace Configuration (RECOMMENDED - Zero PC Load!)
# Get free API key from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_token_here
HUGGINGFACE_MODEL=microsoft/phi-2

# LangSmith Configuration (Optional - for tracing/observability)
# Get free API key from: https://smith.langchain.com
# Leave empty or set LANGCHAIN_TRACING_V2=false to disable
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=astra-ai
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Ollama Configuration (Local models - requires installation)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# vLLM Configuration (Optional - for self-hosted vLLM server)
# VLLM_BASE_URL=http://localhost:8000
# VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ========================================
# MODEL SELECTION
# ========================================
# Primary model for generation
DEFAULT_GENERATOR_MODEL=ollama/llama3.1

# Model for judge agent (can be same or different)
DEFAULT_JUDGE_MODEL=ollama/llama3.1

# ========================================
# DSPY SETTINGS
# ========================================
DSPY_CACHE_DIR=./cache/dspy
DSPY_MAX_TOKENS=500
DSPY_TEMPERATURE=0.7

# ========================================
# OPTIMIZATION SETTINGS
# ========================================
MAX_ITERATIONS=10
CONVERGENCE_THRESHOLD=8.5
MIN_IMPROVEMENT_RATE=0.02

# ========================================
# EVALUATION CRITERIA WEIGHTS
# ========================================
WEIGHT_CORRECTNESS=0.40
WEIGHT_CLARITY=0.20
WEIGHT_REASONING=0.20
WEIGHT_RELEVANCE=0.10
WEIGHT_CONCISENESS=0.10

# ========================================
# LOGGING & ANALYTICS
# ========================================
LOG_LEVEL=INFO
LOG_DIR=./logs
RESULTS_DIR=./results
EXPORT_FORMAT=json

# ========================================
# PERFORMANCE SETTINGS
# ========================================
BATCH_SIZE=5
PARALLEL_PROCESSING=false
REQUEST_TIMEOUT=120
